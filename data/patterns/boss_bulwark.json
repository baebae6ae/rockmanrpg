{
  "id": "boss_bulwark",
  "sequence": [
    { "op": "face_player" },
    { "op": "charge", "speed": "$charge_speed", "distance": 90 },
    { "op": "melee", "w": 28, "h": 26, "duration": 0.22, "power": "$melee_power" },
    { "op": "wait", "duration": 0.35 },

    { "op": "face_player" },
    { "op": "shoot_aimed", "count": 3, "spread": 14, "interval": 0.12, "speed": "$shot_speed", "power": "$shot_power", "element": "$element", "radius": 3, "color": "$color" },
    { "op": "wait", "duration": 0.4 },

    { "op": "invulnerable", "value": true },
    { "op": "telegraph", "anim": "telegraph", "duration": 0.4 },
    { "op": "shoot", "count": 10, "spread": 120, "interval": 0.045, "speed": "$fan_speed", "power": "$shot_power", "element": "$element", "radius": 3, "color": "$color" },
    { "op": "shoot", "count": 10, "spread": 120, "interval": 0.045, "speed": "$fan_speed", "power": "$shot_power", "element": "$element", "radius": 3, "color": "$color" },
    { "op": "invulnerable", "value": false },
    { "op": "wait", "duration": 0.5 },

    {
      "op": "if_hp_below",
      "ratio": 0.4,
      "then": [
        { "op": "invulnerable", "value": true },
        { "op": "telegraph", "anim": "telegraph", "duration": 0.35 },
        { "op": "shoot", "count": 14, "spread": 160, "interval": 0.03, "speed": "$fan_speed", "power": "$shot_power", "element": "$element", "radius": 3, "color": "$color" },
        { "op": "invulnerable", "value": false },
        { "op": "wait", "duration": 0.5 }
      ]
    },
    { "op": "loop", "count": -1 }
  ]
}
