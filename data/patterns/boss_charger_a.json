{
  "id": "boss_charger_a",
  "sequence": [
    { "op": "face_player" },
    { "op": "telegraph", "anim": "telegraph", "duration": 0.45 },
    { "op": "charge", "speed": "$charge_speed", "distance": 110 },
    { "op": "wait", "duration": 0.3 },

    { "op": "face_player" },
    { "op": "shoot_aimed", "count": 3, "spread": 18, "interval": 0.12, "speed": "$shot_speed", "power": "$shot_power", "element": "$element", "radius": 3, "color": 11992974 },
    { "op": "wait", "duration": 0.45 },

    {
      "op": "random",
      "options": [
        [
          { "op": "face_player" },
          { "op": "jump", "vy": 265, "vx": 75, "timeout": 2.5 },
          { "op": "melee", "w": 30, "h": 26, "duration": 0.25, "power": "$melee_power" }
        ],
        [
          { "op": "face_player" },
          { "op": "shoot_aimed", "count": 5, "spread": 32, "interval": 0.07, "speed": "$shot_speed", "power": "$shot_power", "element": "$element", "radius": 3, "color": 11992974 }
        ],
        [
          { "op": "face_player" },
          { "op": "telegraph", "anim": "telegraph", "duration": 0.3 },
          { "op": "charge", "speed": "$charge_speed", "distance": 150 }
        ]
      ]
    },
    { "op": "wait", "duration": 0.5 },

    {
      "op": "if_hp_below",
      "ratio": 0.5,
      "then": [
        { "op": "invulnerable", "value": true },
        { "op": "teleport", "x": "$lair_center", "y": 208, "fade": 0.35 },
        { "op": "telegraph", "anim": "telegraph", "duration": 0.4 },
        { "op": "shoot", "count": 8, "spread": 85, "interval": 0.05, "speed": 135, "power": "$shot_power", "element": "$element", "radius": 3, "color": 11992974 },
        { "op": "invulnerable", "value": false },
        { "op": "wait", "duration": 0.4 }
      ]
    },
    { "op": "loop", "count": -1 }
  ]
}
